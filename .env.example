# Database (required for Auth.js Drizzle adapter; create a PostgreSQL DB and run migrations)
DATABASE_URL="postgres://user:password@localhost:5432/tennis_tracker"

# Auth.js - generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=""

# Google OAuth - create credentials at https://console.cloud.google.com/apis/credentials
# Add authorized redirect URI: http://localhost:3000/api/auth/callback/google (and your production URL)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI — Phase 5c match preparation advice (Railway staging + production)
OPENAI_API_KEY=""
# Optional overrides (defaults: gpt-5.6-terra, reasoning effort low)
# Model IDs: https://developers.openai.com/api/docs/models
# OPENAI_MATCH_PREP_MODEL="gpt-5.6-terra"
# OPENAI_MATCH_PREP_REASONING_EFFORT="low"  # none | low | medium | high | xhigh | max
